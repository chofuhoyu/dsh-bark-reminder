{
  "name": "dsh-bark-reminder",
  "version": "0.1.5",
  "private": true,
  "description": "Push Bark notifications to your iPhone when DeepSeek Harness requires your attention: approvals, auto-review feedback, sandbox escalation, questions, and finished turns.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "bark",
    "notification",
    "reminder"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.png": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host/**/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
